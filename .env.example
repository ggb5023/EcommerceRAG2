# Application examples only. Database credentials: /etc/ecommerce-rag/dev.env.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
V2_GRPC_ADDR=127.0.0.1:50052
V2_INGEST_GRPC_ADDR=127.0.0.1:50053
INGEST_CONCURRENCY=2
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
CONTROL_MODEL=qwen3.8-flash
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1024
RERANK_MODEL=qwen3.7-text-rerank
GENERATION_MODEL=qwen3.7-plus
RAG_PROFILE=v2_langchain_mock
V2_PROVIDER_CONFIG=/etc/ecommerce-rag/providers.env
V2_GATEWAY_DSN=
V2_RETRIEVER_DSN=
V2_CHECKPOINT_DSN=
V2_INGEST_DSN=
V2_IDENTITY_TENANT=
V2_IDENTITY_USER=
V2_IDENTITY_SHOP=
V2_INGEST_POLL_SECONDS=0.9
V2_INGEST_LEASE_SECONDS=45
V2_START_TIMEOUT_SECONDS=30
V2_STOP_TIMEOUT_SECONDS=8
INGEST_STORAGE_PROFILE=filesystem
# Set an absolute artifact directory outside the tracked tree.
INGEST_ARTIFACT_ROOT=
MINERU_TOKEN=
TAVILY_API_KEY=
