# Application examples only. Database credentials: /etc/ecommerce-rag/dev.env.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
GRPC_ADDR=127.0.0.1:50051
INGEST_CONCURRENCY=2
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
CONTROL_MODEL=qwen3.8-flash
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1024
RERANK_MODEL=qwen3.7-text-rerank
GENERATION_MODEL=qwen3.7-plus
RAG_PROFILE=v2_langgraph_fixture
V2_PROVIDER_CONFIG=/etc/ecommerce-rag/providers.env
# Optional. Leave empty for the in-memory development checkpoint. Production
# must provide a restricted application-role DSN and apply SQL migration 0015.
V2_CHECKPOINT_DSN=
# Optional v2 ingestion database DSN. When empty, the v2 gRPC fixture exposes
# no durable submission or worker and remains read-only.
V2_INGEST_DSN=
V2_INGEST_POLL_SECONDS=0.9
V2_INGEST_LEASE_SECONDS=45
MINERU_TOKEN=
TAVILY_API_KEY=
