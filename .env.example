# 运行时配置示例（复制到仓库外，权限 0600）。
# 只有 scripts/dev/v2_services.py 的 CONFIG_KEYS 白名单里的键可以出现在这里，
# 多写一个键或重复一个键，进程会拒绝启动：runtime config contains an invalid or duplicate key。
# 模型与第三方凭据不在这里，见 providers.env.example。

APP_ENV=development
RAG_PROFILE=v2_langchain_mock

# 在线档（v2_langchain_bailian）必填；离线档留空即可。
V2_PROVIDER_CONFIG=/etc/ecommerce-rag/providers.env
V2_ONLINE_BUDGET_LEDGER=/etc/ecommerce-rag/budget.sqlite
V2_ONLINE_BUDGET_ID=
V2_ONLINE_BUDGET_CNY=

# 四个服务各自的数据库连接串。
V2_GATEWAY_DSN=
V2_RETRIEVER_DSN=
V2_CHECKPOINT_DSN=
V2_INGEST_DSN=

# 开发身份：tenant/user 填 external_id（不是自增主键）。
V2_IDENTITY_PROFILE=development
V2_IDENTITY_TENANT=
V2_IDENTITY_USER=
V2_IDENTITY_SHOP=

# Go 签发 scope 的签名密钥文件，0600，内容至少 32 字节。
SCOPE_SIGNING_KEY_FILE=

# 服务监听地址，必须互不相同；HTTP 只允许 loopback。
HTTP_ADDR=127.0.0.1:8080
V2_GRPC_ADDR=127.0.0.1:50052
V2_INGEST_GRPC_ADDR=127.0.0.1:50053

# 顾客通道。启用后写请求会校验 Origin、CSRF 与 Idempotency-Key。
V2_CUSTOMER_ORIGIN=http://127.0.0.1:5173
V2_CUSTOMER_LOOPBACK_HTTP=1

# 摄取产物落在仓库外的绝对路径。
INGEST_STORAGE_PROFILE=filesystem
INGEST_ARTIFACT_ROOT=/data/app/artifacts

V2_START_TIMEOUT_SECONDS=30
V2_STOP_TIMEOUT_SECONDS=8
V2_INGEST_POLL_SECONDS=0.9
V2_INGEST_LEASE_SECONDS=45

# 留空表示进程间明文；只有显式写了取值才走 mTLS，需要同时提供下列三项。
V2_RPC_TLS=
V2_RPC_CA_FILE=
V2_RPC_CERT_FILE=
V2_RPC_KEY_FILE=
