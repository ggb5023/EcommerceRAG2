# Provider 配置示例（复制到仓库外，权限 0600，属主为运行服务的用户）。
# 百炼、MinerU、Tavily 都从这一个文件读取；python/app/providers/config.py
# 明确不合并 os.environ，写进运行时配置或 .env 一律无效。

# ── 离线档：不联网、不产生费用，不需要任何密钥 ──────────────────────────
PROVIDER_PROFILE=mock
CONTROL_MODEL=mock-control
EMBEDDING_MODEL=mock-embedding
RERANK_MODEL=mock-rerank
GENERATION_MODEL=mock-generation
EMBEDDING_DIMENSIONS=1024

# ── 在线档：把 PROVIDER_PROFILE 改成 aliyun-bailian 并填写以下各项 ─────
# BAILIAN_ENDPOINT 是不带 /api/v1 的基址：代码自己拼 compatible-mode/v1/... 和 api/v1/services/...
#PROVIDER_PROFILE=aliyun-bailian
#DASHSCOPE_API_KEY=
#BAILIAN_ENDPOINT=https://dashscope.aliyuncs.com
#BAILIAN_REGION=cn-beijing
#BAILIAN_WORKSPACE_ID=
#CONTROL_MODEL=
#EMBEDDING_MODEL=
#RERANK_MODEL=
#GENERATION_MODEL=
#PROVIDER_TIMEOUT_S=60
#PROVIDER_QUOTA_RPM=60

# ── MinerU：文档解析，被摄取流程调用 ────────────────────────────────────
#MINERU_TOKEN=
#MINERU_ENDPOINT=https://mineru.net/api/v4
#MINERU_TIMEOUT_S=30
#MINERU_POLL_INTERVAL_S=3
#MINERU_POLL_TIMEOUT_S=300

# ── Tavily：联网检索工具 ────────────────────────────────────────────────
#TAVILY_API_KEY=
